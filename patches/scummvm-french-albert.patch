+// "Update Calculated Fields" replaces each "<name>" in the label's text with the
+// current value of the variable called "name", searched for on the label and then
+// on its parents. Unknown names are left as they are.
+void TextLabelElement::updateCalculatedFields() {
+	if (_isBitmap)
+		return;
+
+	const Common::String &tmpl = _calculatedFieldTemplate;
+	Common::String result;
+	bool changed = false;
+
+	uint32 pos = 0;
+	while (pos < tmpl.size()) {
+		size_t open = tmpl.find('<', pos);
+		if (open == Common::String::npos) {
+			result += tmpl.substr(pos);
+			break;
+		}
+
+		size_t close = tmpl.find('>', open + 1);
+		if (close == Common::String::npos) {
+			result += tmpl.substr(pos);
+			break;
+		}
+
+		result += tmpl.substr(pos, open - pos);
+
+		Common::String fieldName = tmpl.substr(open + 1, close - open - 1);
+		VariableModifier *var = findVariableForCalculatedField(fieldName);
+		debug(2, "Text label '%s': calculated field '%s' %s", getName().c_str(), fieldName.c_str(), var ? "resolved" : "not found");
+		if (var) {
+			DynamicValue value;
+			var->varGetValue(value);
+
+			switch (value.getType()) {
+			case DynamicValueTypes::kString:
+				result += value.getString();
+				break;
+			case DynamicValueTypes::kInteger:
+				result += Common::String::format("%i", static_cast<int>(value.getInt()));
+				break;
+			case DynamicValueTypes::kFloat:
+				result += Common::String::format("%g", value.getFloat());
+				break;
+			case DynamicValueTypes::kBoolean:
+				result += value.getBool() ? "true" : "false";
+				break;
+			default:
+				warning("Calculated field '%s' in text label '%s' has an unsupported value type", fieldName.c_str(), getName().c_str());
+				break;
+			}
+			changed = true;
+		} else {
+			result += tmpl.substr(open, close - open + 1);
+		}
+
+		pos = close + 1;
+	}
+
+	if (!changed)
+		return;
+
+	debug(2, "Text label '%s': calculated text '%s'", getName().c_str(), result.c_str());
+	_text = result;
+	_needsRender = true;
+	_contentsDirty = true;
+	_macFormattingSpans.clear();
+}
+
+static VariableModifier *findVariableInModifierContainer(const IModifierContainer *container, const Common::String &name) {
+	for (const Common::SharedPtr<Modifier> &modifier : container->getModifiers()) {
+		if (modifier->isVariable() && modifier->getName().equalsIgnoreCase(name))
+			return static_cast<VariableModifier *>(modifier.get());
+	}
+
+	// Variables kept inside behaviors are visible to the element too
+	for (const Common::SharedPtr<Modifier> &modifier : container->getModifiers()) {
+		if (!modifier->isBehavior())
+			continue;
+
+		IModifierContainer *childContainer = modifier->getChildContainer();
+		if (childContainer) {
+			if (VariableModifier *var = findVariableInModifierContainer(childContainer, name))
+				return var;
+		}
+	}
+
+	return nullptr;
+}
+
+VariableModifier *TextLabelElement::findVariableForCalculatedField(const Common::String &name) const {
+	for (const Structural *structural = this; structural; structural = structural->getParent()) {
+		if (VariableModifier *var = findVariableInModifierContainer(structural, name))
+			return var;
+	}
+
+	// The shared scene stays loaded beside every page, and holds page-wide variables
+	Common::SharedPtr<Structural> sharedScene = getRuntime()->getActiveSharedScene();
+	if (sharedScene)
+		return findVariableInModifierContainer(sharedScene.get(), name);
+
+	return nullptr;
+}
