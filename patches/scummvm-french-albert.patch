+// Uncle Albert's Magical Album: the French intro scene ('film', 0x19ed77) leaves only
+// when its movie (0x19d81b) sends "At Last Cel"; unlike the Greek release, nothing in
+// it responds to the mouse. Send that event early so Escape or a click skips the film
+// through the game's own end-of-movie messenger.
+bool Runtime::skipAlbertIntroMovie() {
+	if (!_activeMainScene || _activeMainScene->getStaticGUID() != 0x0019ed77 || !_project || _project->getLanguage() != Common::FR_FRA) {
+		_albertIntroSkipScene = nullptr;
+		return false;
+	}
+
+	if (_albertIntroSkipScene == _activeMainScene.get())
+		return true;
+
+	Common::Array<Structural *> pending;
+	pending.push_back(_activeMainScene.get());
+	while (!pending.empty()) {
+		Structural *structural = pending.back();
+		pending.pop_back();
+
+		if (structural->getStaticGUID() == 0x0019d81b) {
+			_albertIntroSkipScene = _activeMainScene.get();
+			queueEventAsLowLevelSceneStateTransitionAction(Event(EventIDs::kAtLastCel, 0), structural, true, true);
+			return true;
+		}
+
+		for (const Common::SharedPtr<Structural> &child : structural->getChildren())
+			pending.push_back(child.get());
+	}
+
+	return false;
+}
