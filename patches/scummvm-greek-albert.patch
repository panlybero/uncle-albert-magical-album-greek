+class Windows1253GreekFont : public Graphics::Font {
+public:
+	explicit Windows1253GreekFont(const Graphics::Font *baseFont) : _baseFont(baseFont) {}
+
+	int getFontHeight() const override { return _baseFont->getFontHeight(); }
+	int getFontAscent() const override { return _baseFont->getFontAscent(); }
+	int getMaxCharWidth() const override { return MAX(6, _baseFont->getMaxCharWidth()); }
+	int getCharWidth(uint32 chr) const override {
+		if (chr >= 0xA0 && chr <= 0xFF)
+			return 6;
+		return _baseFont->getCharWidth(chr);
+	}
+	void drawChar(Graphics::Surface *dst, uint32 chr, int x, int y, uint32 color) const override {
+		if (chr >= 0xA0 && chr <= 0xFF) {
+			const uint8 *glyph = kWin1253GreekGlyphs[chr - 0xA0];
+			for (int gy = 0; gy < 12; ++gy) {
+				int py = y + gy;
+				if (py < 0 || py >= dst->h)
+					continue;
+				uint8 rowBits = glyph[gy];
+				if (!rowBits)
+					continue;
+				for (int gx = 0; gx < 6; ++gx) {
+					if (rowBits & (0x80 >> gx)) {
+						int px = x + gx;
+						if (px >= 0 && px < dst->w) {
+							if (dst->format.bytesPerPixel == 1)
+								*static_cast<uint8 *>(dst->getBasePtr(px, py)) = static_cast<uint8>(color);
+						}
+					}
+				}
+			}
+			return;
+		}
+		_baseFont->drawChar(dst, chr, x, y, color);
+	}
+
+private:
+	const Graphics::Font *_baseFont;
+};
