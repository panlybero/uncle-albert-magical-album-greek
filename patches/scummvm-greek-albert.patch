 VThreadState SaveBitmapModifier::consumeMessage(Runtime *runtime, const Common::SharedPtr<MessageProperties> &msg) {
+	if (!_saveWhen.respondsTo(msg->getEvent()))
+		return kVThreadReturn;
+
+	BitmapVariableStorage *storage = resolveBitmapStorage(this, _bitmapVarRef);
+	if (!storage || !storage->_surface || storage->_surface->empty())
+		return kVThreadReturn;
+
+	Common::String rawPath;
+	if (!resolveStringVariable(runtime, this, _pathVarRef, rawPath) || rawPath.empty())
+		return kVThreadReturn;
+
+	if (!g_system || !g_system->getSavefileManager())
+		return kVThreadReturn;
+
+	Common::String saveName = makeSaveFileNameForBitmapPath(rawPath);
+	Common::ScopedPtr<Common::OutSaveFile> saveFile(g_system->getSavefileManager()->openForSaving(saveName, false));
+	if (!saveFile)
+		return kVThreadReturn;
+
+	const Graphics::ManagedSurface &surf = *storage->_surface;
+	int w = surf.w;
+	int h = surf.h;
+	if (surf.format.bytesPerPixel == 1) {
+		uint32 rowStride = (w + 3) & ~3;
+		uint32 imageSize = rowStride * h;
+		uint32 fileSize = 14 + 40 + 1024 + imageSize;
+		saveFile->writeByte('B');
+		saveFile->writeByte('M');
+		saveFile->writeUint32LE(fileSize);
+		saveFile->writeUint32LE(0);
+		saveFile->writeUint32LE(14 + 40 + 1024);
+		saveFile->writeUint32LE(40);
+		saveFile->writeSint32LE(w);
+		saveFile->writeSint32LE(h);
+		saveFile->writeUint16LE(1);
+		saveFile->writeUint16LE(8);
+		saveFile->writeUint32LE(0);
+		saveFile->writeUint32LE(imageSize);
+		saveFile->writeSint32LE(2835);
+		saveFile->writeSint32LE(2835);
+		saveFile->writeUint32LE(256);
+		saveFile->writeUint32LE(256);
+
+		byte pal[256 * 3];
+		memset(pal, 0, sizeof(pal));
+		if (surf.hasPalette())
+			surf.grabPalette(pal, 0, 256);
+		for (int i = 0; i < 256; i++) {
+			saveFile->writeByte(pal[i * 3 + 2]);
+			saveFile->writeByte(pal[i * 3 + 1]);
+			saveFile->writeByte(pal[i * 3 + 0]);
+			saveFile->writeByte(0);
+		}
+		for (int y = h - 1; y >= 0; y--) {
+			const byte *row = static_cast<const byte *>(surf.getBasePtr(0, y));
+			saveFile->write(row, w);
+			for (uint32 pad = w; pad < rowStride; pad++)
+				saveFile->writeByte(0);
+		}
+	} else {
+		Image::writeBMP(*saveFile, surf.rawSurface());
+	}
+	saveFile->finalize();
+
 	return kVThreadReturn;
 }
 
