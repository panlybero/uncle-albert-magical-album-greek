+class ChunkedHTTPReadStream : public Common::SeekableReadStream {
+public:
+	static const int32 kChunkSize = 512 * 1024; // 512 KB chunks for low-latency streaming
+	static const int kNumSlots = 4;             // 4-slot LRU so interleaved video+audio seeks don't thrash
+
+	struct ChunkSlot {
+		int64 chunkIndex;
+		int32 chunkLen;
+		uint32 lastUsedTick;
+		byte *buffer;
+	};
+
+	ChunkedHTTPReadStream(const Common::String &url, int64 totalSize)
+		: _url(url), _size(totalSize), _pos(0), _eos(false), _err(false), _useTick(0) {
+		for (int i = 0; i < kNumSlots; i++) {
+			_slots[i].chunkIndex = -1;
+			_slots[i].chunkLen = 0;
+			_slots[i].lastUsedTick = 0;
+			_slots[i].buffer = new byte[kChunkSize];
+		}
+	}
+
+	~ChunkedHTTPReadStream() override {
+		for (int i = 0; i < kNumSlots; i++) {
+			delete[] _slots[i].buffer;
+		}
+	}
+
+	bool eos() const override { return _eos; }
+	bool err() const override { return _err; }
+	void clearErr() override { _eos = false; _err = false; }
+
+	int64 pos() const override { return _pos; }
+	int64 size() const override { return _size; }
+
+	bool seek(int64 offset, int whence = SEEK_SET) override {
+		int64 newPos = _pos;
+		switch (whence) {
+		case SEEK_SET:
+			newPos = offset;
+			break;
+		case SEEK_CUR:
+			newPos = _pos + offset;
+			break;
+		case SEEK_END:
+			newPos = _size + offset;
+			break;
+		default:
+			return false;
+		}
+		if (newPos < 0 || newPos > _size) {
+			return false;
+		}
+		_pos = newPos;
+		_eos = false;
+		return true;
+	}
+
+	uint32 read(void *dataPtr, uint32 dataSize) override {
+		if (dataSize == 0)
+			return 0;
+		if (_pos >= _size) {
+			_eos = true;
+			return 0;
+		}
+
+		byte *dst = static_cast<byte *>(dataPtr);
+		uint32 totalRead = 0;
+
+		while (dataSize > 0 && _pos < _size) {
+			int64 chunkIdx = _pos / kChunkSize;
+			int32 offsetInChunk = static_cast<int32>(_pos % kChunkSize);
+
+			int slotIdx = -1;
+			for (int i = 0; i < kNumSlots; i++) {
+				if (_slots[i].chunkIndex == chunkIdx) {
+					slotIdx = i;
+					break;
+				}
+			}
+
+			if (slotIdx < 0) {
+				// Pick LRU slot
+				slotIdx = 0;
+				for (int i = 1; i < kNumSlots; i++) {
+					if (_slots[i].chunkIndex < 0) {
+						slotIdx = i;
+						break;
+					}
+					if (_slots[i].lastUsedTick < _slots[slotIdx].lastUsedTick) {
+						slotIdx = i;
+					}
+				}
+
+				int64 chunkStart = chunkIdx * kChunkSize;
+				int64 chunkEnd = MIN<int64>(_size - 1, chunkStart + kChunkSize - 1);
+				int fetched = _httpFsTryGetCachedRange(
+					_url.c_str(),
+					static_cast<int>(chunkStart),
+					static_cast<int>(chunkEnd),
+					_slots[slotIdx].buffer,
+					static_cast<int>(kChunkSize),
+					static_cast<int>(_size)
+				);
+				if (fetched <= 0) {
+					fetched = _httpFsFetchRange(
+						_url.c_str(),
+						static_cast<int>(chunkStart),
+						static_cast<int>(chunkEnd),
+						_slots[slotIdx].buffer,
+						static_cast<int>(kChunkSize),
+						static_cast<int>(_size)
+					);
+				}
+				if (fetched <= 0) {
+					_err = true;
+					break;
+				}
+				_slots[slotIdx].chunkIndex = chunkIdx;
+				_slots[slotIdx].chunkLen = fetched;
+			}
+
+			_slots[slotIdx].lastUsedTick = ++_useTick;
+
+			int32 availInChunk = _slots[slotIdx].chunkLen - offsetInChunk;
+			if (availInChunk <= 0) {
+				_eos = true;
+				break;
+			}
+
+			uint32 toCopy = MIN<uint32>(dataSize, static_cast<uint32>(availInChunk));
+			memcpy(dst + totalRead, _slots[slotIdx].buffer + offsetInChunk, toCopy);
+			_pos += toCopy;
+			totalRead += toCopy;
+			dataSize -= toCopy;
+		}
+
+		if (totalRead < dataSize && !_err) {
+			_eos = true;
+		}
+		return totalRead;
+	}
+
+private:
+	Common::String _url;
+	int64 _size;
+	int64 _pos;
+	bool _eos;
+	bool _err;
+	uint32 _useTick;
+	ChunkSlot _slots[kNumSlots];
+};
