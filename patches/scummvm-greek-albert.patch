+void TextLabelElement::onKeyboardEvent(Runtime *runtime, const KeyboardInputEvent &keyEvt) {
+	if (!_editable || !_selected || !_visible)
+		return;
+
+	if (keyEvt.getKeyEventType() != Common::EVENT_KEYDOWN)
+		return;
+
+	const Common::KeyState &ks = keyEvt.getKeyState();
+	if (ks.keycode == Common::KEYCODE_BACKSPACE || ks.keycode == Common::KEYCODE_DELETE) {
+		if (!_text.empty()) {
+			_text.deleteLastChar();
+			_needsRender = true;
+			_isBitmap = false;
+			_contentsDirty = true;
+			_macFormattingSpans.clear();
+		}
+	} else if (ks.keycode != Common::KEYCODE_RETURN && ks.keycode != Common::KEYCODE_KP_ENTER
+		&& ks.keycode != Common::KEYCODE_ESCAPE && ks.keycode != Common::KEYCODE_TAB) {
+		uint8 ch = 0;
+		if (ks.ascii >= 32 && ks.ascii <= 255) {
+			ch = static_cast<uint8>(ks.ascii);
+		} else if (runtime->getProject()->getLanguage() == Common::EL_GRC && ks.ascii >= 0x0384 && ks.ascii <= 0x03CE) {
+			ch = unicodeGreekToWindows1253(ks.ascii);
+		}
+		if (ch != 0) {
+			_text += static_cast<char>(ch);
+			_needsRender = true;
+			_isBitmap = false;
+			_contentsDirty = true;
+			_macFormattingSpans.clear();
+		}
+	}
+}
