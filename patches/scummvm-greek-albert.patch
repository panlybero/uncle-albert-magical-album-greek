+bool BehaviorModifier::readAttribute(MiniscriptThread *thread, DynamicValue &result, const Common::String &attrib) {
+	Modifier *var = findChildByName(attrib);
+	if (var) {
+		result.setObject(var->getSelfReference());
+		return true;
+	}
+	return Modifier::readAttribute(thread, result, attrib);
+}
+
+bool BehaviorModifier::readAttributeIndexed(MiniscriptThread *thread, DynamicValue &result, const Common::String &attrib, const DynamicValue &index) {
+	Modifier *var = findChildByName(attrib);
+	if (var && var->isVariable())
+		return var->readAttributeIndexed(thread, result, "value", index);
+
+	return Modifier::readAttributeIndexed(thread, result, attrib, index);
+}
+
+MiniscriptInstructionOutcome BehaviorModifier::writeRefAttribute(MiniscriptThread *thread, DynamicValueWriteProxy &writeProxy, const Common::String &attrib) {
+	Modifier *var = findChildByName(attrib);
+	if (var) {
+		if (var->isVariable())
+			writeProxy = static_cast<VariableModifier *>(var)->createWriteProxy();
+		else if (var->isModifier())
+			DynamicValueWriteObjectHelper::create(var, writeProxy);
+		else
+			return kMiniscriptInstructionOutcomeFailed;
+
+		return kMiniscriptInstructionOutcomeContinue;
+	}
+
+	return Modifier::writeRefAttribute(thread, writeProxy, attrib);
+}
