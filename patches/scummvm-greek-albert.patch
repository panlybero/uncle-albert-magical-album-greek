+	if (root->isElement() && static_cast<Element *>(root)->isVisual()) {
+		VisualElement *vis = static_cast<VisualElement *>(root);
+		const Common::String &name = vis->getName();
+		if (vis->isVisible() && ((vis->getLayer() >= 900 && vis->getDisplayedBitmap() != nullptr && name.hasPrefix("page_")) || (vis->getLayer() >= 975 && name == "page") || name == "photo_viseur" || name == "pointeur" || name == "objet_vise")) {
+			outElements.push_back(vis);
+		}
+	}
