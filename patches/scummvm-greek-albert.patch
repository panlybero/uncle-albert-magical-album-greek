+	if (attrib == "show") {
+		result.setBool(_show);
+		return true;
+	}
+	if (attrib == "precision") {
+		result.setInt(_precision);
+		return true;
+	}
+	if (attrib == "size" || attrib == "position" || attrib == "width" || attrib == "height" || attrib == "visible" || attrib == "layer") {
+		Structural *owner = findStructuralOwner();
+		if (owner && owner->readAttribute(thread, result, attrib))
