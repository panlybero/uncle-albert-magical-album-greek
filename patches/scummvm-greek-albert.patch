+			if (otherStorage && otherStorage != storage) {
+				if (otherStorage->_surface && !otherStorage->_surface->empty()) {
+					storage->_surface->copyFrom(*otherStorage->_surface);
+				} else {
+					storage->_surface->free();
+				}
+			}
+		}
