+static uint8 unicodeGreekToWindows1253(uint16 u) {
+	if (u >= 0x0390 && u <= 0x03CE && u != 0x03A2)
+		return static_cast<uint8>(u - 0x0390 + 0xC0);
+	switch (u) {
+	case 0x0384: return 0xB4;
+	case 0x0385: return 0xA1;
+	case 0x0386: return 0xA2;
+	case 0x0388: return 0xB8;
+	case 0x0389: return 0xB9;
+	case 0x038A: return 0xBA;
+	case 0x038C: return 0xBC;
+	case 0x038E: return 0xBE;
+	case 0x038F: return 0xBF;
+	default: return 0;
+	}
+}
