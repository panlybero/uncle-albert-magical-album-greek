 VThreadState ScaleBitmapModifier::consumeMessage(Runtime *runtime, const Common::SharedPtr<MessageProperties> &msg) {
+	if (!_scaleWhen.respondsTo(msg->getEvent()))
+		return kVThreadReturn;
+
+	BitmapVariableStorage *storage = resolveBitmapStorage(this, _bitmapVarRef);
+	if (!storage || !storage->_surface || storage->_surface->empty())
+		return kVThreadReturn;
+
+	Common::Point targetSize;
+	DynamicValue dimVal = _dimensionsSource.produceValue(msg->getValue()).dereference();
+	if (dimVal.getType() == DynamicValueTypes::kPoint) {
+		targetSize = dimVal.getPoint();
+	} else if (msg->getValue().getType() == DynamicValueTypes::kPoint) {
+		targetSize = msg->getValue().getPoint();
+	} else {
+		return kVThreadReturn;
+	}
+
+	if (targetSize.x <= 0 || targetSize.y <= 0)
+		return kVThreadReturn;
+
+	int srcW = storage->_surface->w;
+	int srcH = storage->_surface->h;
+	int dstW = targetSize.x;
+	int dstH = targetSize.y;
+
+	if (srcW != dstW || srcH != dstH) {
+		Graphics::ManagedSurface scaled(dstW, dstH, storage->_surface->format);
+		if (storage->_surface->hasPalette()) {
+			byte pal[256 * 3];
+			storage->_surface->grabPalette(pal, 0, 256);
+			scaled.setPalette(pal, 0, 256);
+		}
+		int bpp = storage->_surface->format.bytesPerPixel;
+		for (int y = 0; y < dstH; y++) {
+			int srcY = (y * srcH) / dstH;
+			const byte *srcRow = static_cast<const byte *>(storage->_surface->getBasePtr(0, srcY));
+			byte *dstRow = static_cast<byte *>(scaled.getBasePtr(0, y));
+			if (bpp == 1) {
+				for (int x = 0; x < dstW; x++)
+					dstRow[x] = srcRow[(x * srcW) / dstW];
+			} else if (bpp == 2) {
+				const uint16 *srcRow16 = reinterpret_cast<const uint16 *>(srcRow);
+				uint16 *dstRow16 = reinterpret_cast<uint16 *>(dstRow);
+				for (int x = 0; x < dstW; x++)
+					dstRow16[x] = srcRow16[(x * srcW) / dstW];
+			} else if (bpp == 4) {
+				const uint32 *srcRow32 = reinterpret_cast<const uint32 *>(srcRow);
+				uint32 *dstRow32 = reinterpret_cast<uint32 *>(dstRow);
+				for (int x = 0; x < dstW; x++)
+					dstRow32[x] = srcRow32[(x * srcW) / dstW];
+			}
+		}
+		storage->_surface->copyFrom(scaled);
+	}
+
+	Structural *owner = findStructuralOwner();
+	if (owner && owner->isElement() && static_cast<Element *>(owner)->isVisual()) {
+		static_cast<VisualElement *>(owner)->setDisplayedBitmap(storage->_surface);
+	}
+	runtime->setSceneGraphDirty();
+
 	return kVThreadReturn;
 }
 
