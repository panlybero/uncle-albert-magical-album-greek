 VThreadState CaptureBitmapModifier::consumeMessage(Runtime *runtime, const Common::SharedPtr<MessageProperties> &msg) {
+	if (!_captureWhen.respondsTo(msg->getEvent()))
+		return kVThreadReturn;
+
+	BitmapVariableStorage *storage = resolveBitmapStorage(this, _bitmapVarRef);
+	if (!storage)
+		return kVThreadReturn;
+
+	Structural *owner = findStructuralOwner();
+	if (!owner || !owner->isElement() || !static_cast<Element *>(owner)->isVisual())
+		return kVThreadReturn;
+
+	VisualElement *visual = static_cast<VisualElement *>(owner);
+	Common::SharedPtr<Window> mainWindow = runtime->getMainWindow().lock();
+	if (!mainWindow || !mainWindow->getSurface())
+		return kVThreadReturn;
+
+	Common::Point globalPos = visual->getGlobalPosition();
+	Common::Rect relRect = visual->getRelativeRect();
+	Common::Rect captureRect(globalPos.x, globalPos.y, globalPos.x + relRect.width(), globalPos.y + relRect.height());
+	Common::Rect winRect(0, 0, mainWindow->getWidth(), mainWindow->getHeight());
+	captureRect = captureRect.findIntersectingRect(winRect);
+	if (captureRect.isEmpty())
+		return kVThreadReturn;
+
+	// Render current scene to an offscreen window with page-turn overlays and the capture box itself hidden
+	Window tempWin(WindowParameters(runtime, 0, 0, mainWindow->getWidth(), mainWindow->getHeight(), mainWindow->getPixelFormat()));
+	if (mainWindow->getSurface()->hasPalette()) {
+		byte pal[256 * 3];
+		mainWindow->getSurface()->grabPalette(pal, 0, 256);
+		tempWin.getSurface()->setPalette(pal, 0, 256);
+	}
+
+	Common::Array<VisualElement *> hiddenElements;
+	Common::Array<Structural *> scenes;
+	runtime->getScenesInRenderOrder(scenes);
+	for (Structural *scene : scenes)
+		collectPageOverlayElements(scene, hiddenElements);
+
+	bool ownerWasVisible = visual->isVisible();
+	for (VisualElement *el : hiddenElements)
+		el->setVisible(runtime, false);
+	if (ownerWasVisible && visual->getLayer() >= 900)
+		visual->setVisible(runtime, false);
+
+	runtime->setSceneGraphDirty();
+	Render::renderProject(runtime, &tempWin, nullptr);
+
+	for (VisualElement *el : hiddenElements)
+		el->setVisible(runtime, true);
+	if (ownerWasVisible && visual->getLayer() >= 900)
+		visual->setVisible(runtime, true);
+	runtime->setSceneGraphDirty();
+
+	if (!storage->_surface)
+		storage->_surface.reset(new Graphics::ManagedSurface());
+	storage->_surface->create(captureRect.width(), captureRect.height(), tempWin.getPixelFormat());
+	if (tempWin.getSurface()->hasPalette()) {
+		byte pal[256 * 3];
+		tempWin.getSurface()->grabPalette(pal, 0, 256);
+		storage->_surface->setPalette(pal, 0, 256);
+	}
+	storage->_surface->copyRectToSurface(*tempWin.getSurface(), 0, 0, captureRect);
+
 	return kVThreadReturn;
 }
 
