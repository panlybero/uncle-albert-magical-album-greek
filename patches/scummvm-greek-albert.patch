+bool BitmapVariableModifier::varSetValue(MiniscriptThread *thread, const DynamicValue &value) {
+	BitmapVariableStorage *storage = static_cast<BitmapVariableStorage *>(_storage.get());
+	if (!storage->_surface)
+		storage->_surface.reset(new Graphics::ManagedSurface());
+
+	if (value.getType() == DynamicValueTypes::kNull || (value.getType() == DynamicValueTypes::kInteger && value.getInt() == 0)) {
+		storage->_surface->free();
+		return true;
