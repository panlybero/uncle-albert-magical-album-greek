+static void copyModifierNamesForSaveLoad(Modifier *loadedMod, Modifier *targetMod) {
+	loadedMod->setName(targetMod->getName());
+	IModifierContainer *loadedContainer = loadedMod->getChildContainer();
+	IModifierContainer *targetContainer = targetMod->getChildContainer();
+	if (loadedContainer && targetContainer) {
+		const Common::Array<Common::SharedPtr<Modifier> > &loadedChildren = loadedContainer->getModifiers();
+		const Common::Array<Common::SharedPtr<Modifier> > &targetChildren = targetContainer->getModifiers();
+		size_t count = MIN(loadedChildren.size(), targetChildren.size());
+		for (size_t i = 0; i < count; i++) {
+			if (loadedChildren[i] && targetChildren[i])
+				copyModifierNamesForSaveLoad(loadedChildren[i].get(), targetChildren[i].get());
+		}
+	}
+}
