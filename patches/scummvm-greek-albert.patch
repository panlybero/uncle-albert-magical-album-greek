+	if (attrib == "paused") {
+		DynamicValueWriteBoolHelper::create(&_paused, result);
+		return kMiniscriptInstructionOutcomeContinue;
+	}
+	if (attrib == "show") {
+		DynamicValueWriteBoolHelper::create(&_show, result);
+		return kMiniscriptInstructionOutcomeContinue;
+	}
+	if (attrib == "precision") {
+		DynamicValueWriteIntegerHelper<int32>::create(&_precision, result);
+		return kMiniscriptInstructionOutcomeContinue;
+	}
+	if (attrib == "size" || attrib == "position" || attrib == "width" || attrib == "height" || attrib == "visible" || attrib == "layer") {
+		Structural *owner = findStructuralOwner();
+		if (owner)
+			return owner->writeRefAttribute(thread, result, attrib);
+	}
+	return Modifier::writeRefAttribute(thread, result, attrib);
+}
+
+MiniscriptInstructionOutcome RotatorModifier::scriptSetAngle(MiniscriptThread *thread, const DynamicValue &value) {
+	if (value.getType() == DynamicValueTypes::kFloat) {
+		_angle = value.getFloat();
+		return kMiniscriptInstructionOutcomeContinue;
+	}
+	if (value.getType() == DynamicValueTypes::kInteger) {
+		_angle = static_cast<double>(value.getInt());
+		return kMiniscriptInstructionOutcomeContinue;
+	}
+	return kMiniscriptInstructionOutcomeContinue;
+}
