+		if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))
+			normalized += tolower(c);
+		else if (c == '/' || c == '\\' || c == ':' || c == '.' || c == '_')
+			normalized += '_';
+	}
+	return Common::String("albert1_bmp_") + normalized;
+}
+
+static void collectPageOverlayElements(Structural *root, Common::Array<VisualElement *> &outElements) {
+	if (!root)
