+bool Project::loadModifierFromNativeSaveFile(const Common::String &fileName, Modifier *targetModifier) {
+	if (!_rootArchive || !targetModifier)
+		return false;
+
+	Common::SharedPtr<Common::SeekableReadStream> fileStream;
+	Common::Path defaultPath = _projectRootDir.appendComponent(fileName);
+
+	if (_platform == kProjectPlatformMacintosh)
+		fileStream.reset(Common::MacResManager::openFileOrDataFork(defaultPath, *_rootArchive));
+	else
+		fileStream.reset(_rootArchive->createReadStreamForMember(defaultPath));
+
+	if (!fileStream) {
+		Common::ArchiveMemberList memberList;
+		_rootArchive->listMembers(memberList);
+
+		for (const Common::ArchiveMemberPtr &member : memberList) {
+			if (member->getFileName().equalsIgnoreCase(fileName)) {
+				if (_platform == kProjectPlatformMacintosh)
+					fileStream.reset(Common::MacResManager::openFileOrDataFork(member->getPathInArchive(), *_rootArchive));
+				else
+					fileStream.reset(member->createReadStream());
+				if (fileStream)
+					break;
+			}
+		}
+	}
+
+	if (!fileStream || fileStream->size() <= 4)
+		return false;
+
+	uint32 header = fileStream->readUint32LE();
+	if (header != 0) {
+		warning("Unexpected header 0x%x in native modifier save file '%s'", header, fileName.c_str());
+		return false;
+	}
+
+	Common::SeekableSubReadStream subStream(fileStream.get(), 4, fileStream->size());
+	Data::DataReader reader(4, subStream, (_platform == kProjectPlatformMacintosh) ? Data::kDataFormatMacintosh : Data::kDataFormatWindows, _runtimeVersion, _isRuntimeVersionAutoDetect);
+
+	SimpleModifierContainer rootContainer;
+	ChildLoaderStack loaderStack;
+	ChildLoaderContext rootContext;
+	rootContext.containerUnion.modifierContainer = &rootContainer;
+	rootContext.remainingCount = 1;
+	rootContext.type = ChildLoaderContext::kTypeCountedModifierList;
+	loaderStack.contexts.push_back(rootContext);
+
+	const Data::PlugInModifierRegistry &plugInDataLoaderRegistry = _plugInRegistry.getDataLoaderRegistry();
+
+	while (subStream.pos() < subStream.size() && loaderStack.contexts.size() > 0) {
+		Common::SharedPtr<Data::DataObject> dataObject;
+		Data::loadDataObject(plugInDataLoaderRegistry, reader, dataObject);
+		if (!dataObject) {
+			warning("Failed to parse DataObject in native modifier save file '%s'", fileName.c_str());
+			return false;
+		}
+		loadContextualObject(0, loaderStack, *dataObject.get());
+	}
+
+	if (rootContainer.getModifiers().size() != 1 || !rootContainer.getModifiers()[0])
+		return false;
+
+	Common::SharedPtr<Modifier> loadedMod = rootContainer.getModifiers()[0];
+	copyModifierNamesForSaveLoad(loadedMod.get(), targetModifier);
+
+	Common::SharedPtr<ModifierSaveLoad> srcSaveLoad = loadedMod->getSaveLoad(getRuntime());
+	Common::SharedPtr<ModifierSaveLoad> dstSaveLoad = targetModifier->getSaveLoad(getRuntime());
+	if (!srcSaveLoad || !dstSaveLoad)
+		return false;
+
+	Common::MemoryWriteStreamDynamic memWrite(DisposeAfterUse::YES);
+	srcSaveLoad->save(loadedMod.get(), &memWrite);
+
+	Common::MemoryReadStream memRead(memWrite.getData(), memWrite.size());
+	if (!dstSaveLoad->load(targetModifier, &memRead, 1))
+		return false;
+
+	dstSaveLoad->commitLoad();
+	debug(1, "Loaded native mTropolis variable file '%s' into modifier '%s' (guid 0x%x)", fileName.c_str(), targetModifier->getName().c_str(), targetModifier->getStaticGUID());
+	return true;
+}
